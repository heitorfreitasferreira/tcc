filters:
  and:
    - file.inFolder("siglas")
    - file.ext == "md"
    - file.hasTag("tipo/sigla")
formulas:
  tem_uso: if(ocorrencias_ac > 0, "\\ac", if(ocorrencias_texto > 0, "texto", "nao"))
  total_ocorrencias: if(ocorrencias_ac, ocorrencias_ac, 0) + if(ocorrencias_texto, ocorrencias_texto, 0)
properties:
  file.name:
    displayName: Nota
  sigla:
    displayName: Sigla
  definicao:
    displayName: Definicao
  incluir:
    displayName: Incluir
  formula.tem_uso:
    displayName: Em Uso
  formula.total_ocorrencias:
    displayName: Total
  ocorrencias_ac:
    displayName: Usos \ac
  ocorrencias_texto:
    displayName: Texto
  arquivos_ac:
    displayName: Arquivos
views:
  - type: table
    name: Sumario de Siglas
    order:
      - sigla
      - file.name
      - definicao
      - incluir
      - formula.tem_uso
      - formula.total_ocorrencias
      - ocorrencias_ac
      - ocorrencias_texto
      - arquivos_ac
  - type: table
    name: Incluir na Lista Final
    filters:
      and:
        - incluir == "sim"
    order:
      - sigla
      - file.name
      - definicao
      - formula.tem_uso
      - formula.total_ocorrencias
      - ocorrencias_ac
      - ocorrencias_texto
      - arquivos_ac
  - type: table
    name: Pendentes de Decisao
    filters:
      and:
        - incluir != "sim"
        - incluir != "nao"
    order:
      - sigla
      - file.name
      - definicao
      - formula.tem_uso
      - formula.total_ocorrencias
      - ocorrencias_ac
      - ocorrencias_texto
  - type: table
    name: Excluidas
    filters:
      and:
        - incluir == "nao"
    order:
      - sigla
      - file.name
      - definicao
      - formula.tem_uso
      - formula.total_ocorrencias
